# Cloudflare Pages _redirects is path-only for this project.
# Host-specific canonical behavior is handled in functions/[[path]].js.

# Dynamic XML endpoints are handled once in functions/[[path]].js. Keeping a
# second rewrite layer here bypasses timeout, fallback and cache safeguards.

# Never let missing JS/CSS assets fall through to index.html.
# A stale browser requesting an old chunk must receive a real 404, not HTML
# with a JavaScript URL, otherwise dynamic imports crash with MIME errors.
/assets/* /404.html 404

# React Router SPA fallback.
/* /index.html 200
