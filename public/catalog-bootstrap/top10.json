hong lưu.\r\n\r\nTuy nhiên mọi thứ quay ngoắt lại và họ phải chia tay để mỗi người bước đi trên con đường của riêng mình. Cho đến khi gặp lại ở một bán bar, họ vờ như không nhận ra nhau, thử lòng nhau và cũng muốn bắt đầu thêm một lần nữa. Khi mà cả Ôn Dĩ Phàm và Tang Diên nhận ra được tình cảm của mình là hoàn toàn chân thật thì họ lại một lần nữa vướng phải những rào cản từ phía gia đình và cả công việc. Cuối cùng thì họ nhận ra rằng chỉ tình yêu đích thực mới đưa họ vượt qua được những rào cản và có thể đến với nhau một cách bền vững nhất.","country":[{"id":13,"name":"Trung Quốc","slug":"trung-quoc"}],"created_at":"2026-05-17T16:13:39.99741+00:00","current_episode":32,"director":["Qu You-ning"],"episode_current":"Hoàn Tất (32/32)","episode_total":"32","first_seen_at":"2026-06-12T14:48:18.465226+00:00","hero_backdrop_url":"https://image.tmdb.org/t/p/w1280/lO2CqipALTHkRblLIRDKgtMgwxX.jpg","hero_poster_url":"https://image.tmdb.org/t/p/w500/ywkwBd65CMvC33DDVFOQqr4mrVQ.jpg","id":"c7468aff-330a-4ce1-8259-f9237683e297","imdb_id":null,"is_published":true,"lang":"Vietsub + Thuyết Minh","last_episode_change_at":"2026-07-29T08:35:00.141608+00:00","last_synced_at":"2026-10-13T23:15:09.004+00:00","last_watched_at":null,"modified":{"time":"2026-10-16T17:01:45.225408+00:00"},"name":"Khó Dỗ Dành","next_episode_at":null,"next_episode_name":null,"normalized_name":"kho-do-danh-the-first-frost","notify":"","ophim_id":"5cfcc1972d5e8972ace3c90e609f0f58","ophim_slug":"kho-do-danh","origin_name":"The First Frost","original_title":"","poster_url":"https://vsmov.com/storage/images/lO2CqipALTHkRblLIRDKgtMgwxX.jpg","published_at":"2026-07-21T03:44:11.866643+00:00","quality":"HD","release_at":null,"release_day":null,"release_time":null,"schedule_note":null,"schedule_timezone":"Asia/Ho_Chi_Minh","schedule_type":null,"season_number":null,"seo_catalog_status":"published","showtimes":"","slug":"kho-do-danh","source_name":"OPhim","source_site":"ophim","source_url":"","status":"completed","superse