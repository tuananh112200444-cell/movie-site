alog_source":null,"catalog_synced_at":null,"catalog_window_end":null,"catalog_window_start":null,"category":[{"id":"d3d9446802a44259755d38e6d163e820","name":"Phim Hài","slug":"phim-hai"},{"id":"c51ce410c124a10e0db5e4b97fc2af39","name":"Chính Kịch","slug":"chinh-kich"},{"id":"98f13708210194c475687be6106a3b84","name":"Lãng Mạn","slug":"lang-man"},{"id":"2a79ea27c279e471f4d180b08d62b00a","name":"Tình Cảm","slug":"tinh-cam"}],"content":"Bạn đang tìm kiếm thông tin về bộ phim Tiếng Yêu Này, Anh Dịch Được Không? (tên tiếng Anh: Can This Love Be Translated?, phát hành năm 2026). Đi khắp thế giới để quay chương trình truyền hình, cảm xúc của một người nổi tiếng và phiên dịch viên của cô lại chẳng thể nào thông dịch. Liệu tình yêu có tìm được ngôn ngữ riêng? Được đạo diễn bởi Hong Mi-ran và Hong Jeong-eun, cùng sự tham gia của dàn diễn viên tên tuổi gồm Kim Seon Ho, Go Youn Jung và Fukushi Sota, tác phẩm thuộc các thể loại Phim Hài, Chính Kịch, Lãng Mạn và Tình Cảm hứa hẹn mang đến những trải nghiệm đáng chú ý cho khán giả yêu điện ảnh Hàn Quốc khi xem phim Can This Love Be Translated? bản vietsub hoặc thuyết minh full trên KhoPhim.","country":[{"id":"32bb90e8976aab5298d5da10fe66f21d","name":"Hàn Quốc","slug":"han-quoc"}],"created_at":"2026-05-17T16:04:11.413223+00:00","current_episode":12,"director":["Hong Mi-ran","Hong Jeong-eun"],"episode_current":"Hoàn Tất (12/12)","episode_total":"12","first_seen_at":"2026-06-12T14:48:18.465226+00:00","hero_backdrop_url":"https://phimimg.com/upload/vod/20260116-1/92ad3288f61736574a2a2dd3c4ee5df1.jpg","hero_poster_url":"https://phimimg.com/upload/vod/20260116-1/8b1201713adc08736e33e45ab1c1f2e4.jpg","id":"399c6979-da0d-4b1b-a613-48871222e3f6","imdb_id":null,"is_published":true,"lang":"Vietsub + Lồng Tiếng","last_episode_change_at":"2026-07-23T04:52:50.633204+00:00","last_synced_at":"2026-09-05T21:25:00.45+00:00","last_watched_at":null,"modified":{"time":"2026-10-16T16:46:55.786402+00:00"},"name":"Tiếng Yêu Này, Anh Dịch Được Không?","next